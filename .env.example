# ─── Мониторинг ошибок (Sentry) ─────────────────────────────
# Заполнить для активации. Без DSN Sentry полностью отключён,
# next.config.ts не оборачивается в withSentryConfig.
#
# SENTRY_DSN — серверный DSN (Node.js / Edge runtime)
# NEXT_PUBLIC_SENTRY_DSN — клиентский DSN (браузер)
# Оба необходимы для полной функциональности.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Для загрузки sourcemaps при сборке (опционально, CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Дополнительные настройки Sentry
# SENTRY_TRACES_SAMPLE_RATE=0.1              # Доля транзакций для Performance Monitoring
# SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1     # Доля сессий для Session Replay
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0    # Доля сессий с ошибками для Replay
