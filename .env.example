# ─── Мониторинг ошибок (Sentry) ─────────────────────────────
# Заполнить для активации. Без DSN Sentry полностью отключён,
# next.config.ts не оборачивается в withSentryConfig.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Для загрузки sourcemaps (опционально, CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
